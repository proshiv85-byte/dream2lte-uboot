diff --git a/board/samsung/dream2lte/Kconfig b/board/samsung/dream2lte/Kconfig
new file mode 100644
index 000000000..92b010cb8
--- /dev/null
+++ b/board/samsung/dream2lte/Kconfig
@@ -0,0 +1,38 @@
+if TARGET_DREAM2LTE
+
+config SYS_BOARD
+	default "dream2lte"
+
+config SYS_VENDOR
+	default "samsung"
+
+config SYS_CONFIG_NAME
+	default "dream2lte"
+
+config ENV_SOURCE_FILE
+	default "dream2lte"
+
+# text_offset 0x80000 like the vendor kernel. S-Boot loads the kernel at a
+# random address (Samsung KASLR), U-Boot is position independent for that.
+config LNX_KRNL_IMG_TEXT_OFFSET_BASE
+	default 0x80000000
+
+config DREAM2LTE_RAMOOPS_CONSOLE
+	bool "Mirror the console into the ramoops console zone"
+	default y
+	help
+	  Write all console output into the ramoops console zone at
+	  0x92004000 (the "log_pstore" area of the vendor kernel). The
+	  phone has no accessible UART: after a reset into TWRP the log is
+	  /sys/fs/pstore/pmsg-ramoops-0, and a mainline kernel with the
+	  same ramoops layout shows it as console-ramoops-0.
+
+config DREAM2LTE_DEV_RECOVERY
+	bool "Preset the reboot reason to recovery (development)"
+	help
+	  Set the Samsung reboot reason to "recovery" as early as possible,
+	  so that a hang (forced reset) or a crash of U-Boot ends up in TWRP
+	  instead of boot looping. U-Boot sets it back to "normal" before
+	  it boots an OS, unless the environment variable dev_recovery is 1.
+
+endif
