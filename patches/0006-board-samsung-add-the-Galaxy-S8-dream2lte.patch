diff --git a/arch/arm/dts/exynos8895-dream2lte.dts b/arch/arm/dts/exynos8895-dream2lte.dts
new file mode 100644
index 000000000..51a9a496c
--- /dev/null
+++ b/arch/arm/dts/exynos8895-dream2lte.dts
@@ -0,0 +1,223 @@
+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/*
+ * Samsung Galaxy S8+ (dream2lte/SM-G955F) device tree source for U-Boot
+ *
+ * Based on the upstream exynos8895-dreamlte.dts,
+ * Copyright (c) 2024, Ivaylo Ivanov <ivo.ivanov.ivanov1@gmail.com>
+ *
+ * There is no clock driver for the Exynos 8895 in U-Boot: the clocks
+ * stay as the bootloader set them up, and the UFS host gets their rates
+ * from fixed clocks.
+ */
+
+/dts-v1/;
+#include "exynos8895.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+
+/ {
+	model = "Samsung Galaxy S8+ (SM-G955F)";
+	compatible = "samsung,dream2lte", "samsung,exynos8895";
+	chassis-type = "handset";
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		framebuffer: framebuffer@cc000000 {
+			compatible = "simple-framebuffer";
+			reg = <0 0xcc000000 (1440 * 2960 * 4)>;
+			width = <1440>;
+			height = <2960>;
+			stride = <(1440 * 4)>;
+			format = "a8r8g8b8";
+			bootph-all;
+		};
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x3c800000>,
+		      <0x0 0xc0000000 0x40000000>,
+		      <0x8 0x80000000 0x80000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		ramoops@92000000 {
+			compatible = "ramoops";
+			reg = <0 0x92000000 0x8000>;
+			record-size = <0x4000>;
+			console-size = <0x4000>;
+		};
+
+		tima@b1000000 {
+			reg = <0 0xb1000000 0x200000>;
+			no-map;
+		};
+
+		seclog@c0000000 {
+			reg = <0 0xc0000000 0x10000>;
+			no-map;
+		};
+
+		cont_splash_mem: framebuffer@cc000000 {
+			reg = <0 0xcc000000 (1440 * 2960 * 4)>;
+			no-map;
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&key_power &key_voldown &key_volup &key_wink>;
+		pinctrl-names = "default";
+
+		power-key {
+			label = "Power";
+			linux,code = <KEY_POWER>;
+			gpios = <&gpa2 4 GPIO_ACTIVE_LOW>;
+		};
+
+		voldown-key {
+			label = "Volume Down";
+			linux,code = <KEY_VOLUMEDOWN>;
+			gpios = <&gpa0 4 GPIO_ACTIVE_LOW>;
+		};
+
+		volup-key {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&gpa0 3 GPIO_ACTIVE_LOW>;
+		};
+
+		/* Bixby */
+		wink-key {
+			label = "Bixby";
+			linux,code = <KEY_CAMERA>;
+			gpios = <&gpa0 6 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	/* PCLK of USI13 (HSI2C_32), 66.625 MHz from CMU_PERIC1 */
+	usi13_pclk: clock-usi13-pclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <66625000>;
+		clock-output-names = "usi13_pclk";
+	};
+
+	/* 166.5625 MHz from CMU_FSYS0, as left by S-Boot */
+	ufs_aclk: clock-ufs-aclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <166562500>;
+		clock-output-names = "ufs_embd_aclk";
+	};
+
+	ufs_unipro_clk: clock-ufs-unipro {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <166562500>;
+		clock-output-names = "ufs_embd_unipro";
+	};
+};
+
+/*
+ * USI13 is in I2C mode for the MAX77865 (charger, fuel gauge, MUIC) from
+ * S-Boot; there is no USI v1 driver, the bus just exposes the controller.
+ */
+&usi13 {
+	compatible = "samsung,exynos8895-usi", "simple-bus";
+	status = "okay";
+};
+
+&hsi2c_32 {
+	clocks = <&usi13_pclk>;
+	clock-frequency = <400000>;
+	status = "okay";
+};
+
+&pinctrl_alive {
+	key_power: key-power-pins {
+		samsung,pins = "gpa2-4";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
+	};
+
+	key_voldown: key-voldown-pins {
+		samsung,pins = "gpa0-4";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
+	};
+
+	key_volup: key-volup-pins {
+		samsung,pins = "gpa0-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
+	};
+
+	key_wink: key-wink-pins {
+		samsung,pins = "gpa0-6";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
+	};
+};
+
+&soc {
+	ufs: ufs@11120000 {
+		compatible = "samsung,exynos8895-ufs";
+		reg = <0x11120000 0x200>,
+		      <0x11121100 0x200>,
+		      <0x11110000 0x8000>,
+		      <0x11130000 0x100>;
+		reg-names = "hci", "vs_hci", "unipro", "ufsp";
+		clocks = <&ufs_aclk>, <&ufs_unipro_clk>;
+		clock-names = "core_clk", "sclk_unipro_main";
+		dma-coherent;
+		phys = <&ufs_phy>;
+		phy-names = "ufs-phy";
+		samsung,sysreg = <&syscon_fsys0 0x700>;
+	};
+
+	usbdrd: usb@10c00000 {
+		compatible = "samsung,exynos8895-dwusb3";
+		ranges = <0x0 0x10c00000 0x10000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		usbdrd_dwc3: usb@0 {
+			compatible = "snps,dwc3";
+			reg = <0x0 0x10000>;
+			phys = <&usbdrd_phy 0>;
+			phy-names = "usb2-phy";
+			dr_mode = "peripheral";
+			maximum-speed = "high-speed";
+		};
+	};
+
+	usbdrd_phy: phy@10e00000 {
+		compatible = "samsung,exynos8895-usbdrd-phy";
+		reg = <0x10e00000 0x100>,
+		      <0x10e10000 0x100>,
+		      <0x10e50070 0x10>;
+		samsung,pmu-syscon = <&pmu_system_controller>;
+		#phy-cells = <1>;
+	};
+
+	ufs_phy: phy@11124000 {
+		compatible = "samsung,exynos8895-ufs-phy";
+		reg = <0x11124000 0x800>;
+		reg-names = "phy-pma";
+		samsung,pmu-syscon = <&pmu_system_controller>;
+		#phy-cells = <0>;
+	};
+};
